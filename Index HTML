<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utilitywise | Never miss a bill payment</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#FAFAF9] text-gray-800 pb-20 sm:pb-0">

    <!-- NAVIGATION -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex-shrink-0 flex items-center">
                    <span class="text-2xl font-extrabold text-teal-800">Utilitywise</span>
                </div>
                <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                    <a href="#" class="text-gray-900 inline-flex items-center px-1 pt-1 font-semibold border-b-2 border-teal-800">Home</a>
                    <a href="#" class="text-gray-500 hover:text-gray-900 inline-flex items-center px-1 pt-1 font-medium">How It Works</a>
                    <a href="#" class="text-gray-500 hover:text-gray-900 inline-flex items-center px-1 pt-1 font-medium">Pricing</a>
                </div>
                <div class="hidden sm:flex items-center space-x-4">
                    <a href="#" class="text-teal-800 font-bold hover:text-teal-900">Dial *XXX#</a>
                    <a href="#" class="bg-amber-500 hover:bg-amber-600 text-white px-5 py-2 rounded-lg font-bold shadow-md transition-colors">Download App</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="bg-teal-800 text-white pt-16 pb-20 px-4 sm:px-6 lg:px-8 text-center sm:text-left relative overflow-hidden">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center">
            <div class="sm:w-3/5 sm:pr-12">
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6">
                    Never Be Caught Off Guard by Your Utility Bill Again
                </h1>
                <p class="text-lg sm:text-xl text-teal-100 mb-8 max-w-2xl">
                    Save a little every week. Pay electricity & water bills on time. Works on any smartphone or feature phone.
                </p>
                <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 mb-8">
                    <button class="w-full sm:w-auto bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg text-lg transition-colors">
                        📱 Download Free App
                    </button>
                    <button class="w-full sm:w-auto bg-transparent border-2 border-teal-400 hover:bg-teal-700 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors">
                        📞 Dial *XXX#
                    </button>
                </div>
                <div class="flex items-center justify-center sm:justify-start text-sm text-teal-200 font-medium">
                    <span>✅ Trusted by 10,000+ Kenyan households</span>
                    <span class="mx-2">•</span>
                    <span>🟢 M-Pesa enabled</span>
                </div>
            </div>
            <!-- Mockup Placeholder -->
            <div class="hidden sm:block sm:w-2/5 mt-10 sm:mt-0">
                <div class="bg-teal-700 border-4 border-gray-900 rounded-[2.5rem] h-[500px] w-[250px] mx-auto shadow-2xl relative flex flex-col justify-between p-4">
                    <div class="w-20 h-6 bg-gray-900 absolute top-0 left-1/2 transform -translate-x-1/2 rounded-b-xl"></div>
                    <div class="mt-8 bg-white rounded-xl p-4 text-gray-800 shadow-inner">
                        <p class="text-xs text-gray-500 font-bold uppercase">KPLC Savings Goal</p>
                        <h2 class="text-2xl font-bold text-teal-800">KES 2,500</h2>
                        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                            <div class="bg-amber-500 h-2.5 rounded-full" style="width: 80%"></div>
                        </div>
                    </div>
                    <div class="bg-green-100 border-l-4 border-green-500 p-3 rounded text-sm text-green-800 font-bold mb-4">
                        ✓ Bill Paid Automatically!
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- EMPATHY / PROBLEM SECTION -->
    <section class="py-16 px-4 bg-white">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-3xl font-extrabold text-center text-gray-900 mb-12">End-of-month bill shock is real.</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-[#FAFAF9] p-8 rounded-2xl shadow-sm border border-gray-100">
                    <div class="text-4xl mb-4">💡</div>
                    <p class="text-lg font-semibold text-gray-800">"Your electricity bill arrives and you're short by KES 2,000."</p>
                </div>
                <!-- Card 2 -->
                <div class="bg-[#FAFAF9] p-8 rounded-2xl shadow-sm border border-gray-100">
                    <div class="text-4xl mb-4">💧</div>
                    <p class="text-lg font-semibold text-gray-800">"The water gets disconnected because payment slipped your mind."</p>
                </div>
                <!-- Card 3 -->
                <div class="bg-[#FAFAF9] p-8 rounded-2xl shadow-sm border border-gray-100">
                    <div class="text-4xl mb-4">😰</div>
                    <p class="text-lg font-semibold text-gray-800">"You have to borrow money just to keep the lights on."</p>
                </div>
            </div>
            <p class="text-center text-xl text-teal-800 font-bold mt-12">Utilitywise changes this — one small save at a time.</p>
        </div>
    </section>

    <!-- M-PESA & TRUST SECTION -->
    <section class="py-16 px-4 bg-teal-50 border-t border-teal-100">
        <div class="max-w-4xl mx-auto text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Seamlessly connected to M-Pesa</h3>
            <p class="text-gray-600 mb-8 text-lg">Top up your savings with a simple M-Pesa send — no bank account needed.</p>
            <div class="flex justify-center items-center space-x-6 mb-8">
                <div class="bg-white px-6 py-3 rounded-lg shadow font-bold text-green-600 border border-green-200">M-PESA</div>
                <div class="bg-white px-6 py-3 rounded-lg shadow font-bold text-red-600 border border-red-200">Airtel Money</div>
            </div>
            <p class="text-sm text-gray-500 flex items-center justify-center">
                🔒 Secured by 256-bit encryption • Cancel anytime
            </p>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-gray-900 text-gray-400 py-12 text-center text-sm">
        <p class="mb-2 font-bold text-white text-lg">Utilitywise</p>
        <p class="mb-6">Empowering Kenyan households to stay ahead.</p>
        <div class="space-x-4 mb-6">
            <a href="#" class="hover:text-white">Privacy Policy</a>
            <a href="#" class="hover:text-white">Terms</a>
            <a href="#" class="hover:text-white">Contact</a>
        </div>
        <p>&copy; 2026 Utilitywise Kenya. All rights reserved.</p>
    </footer>

    <!-- MOBILE STICKY BOTTOM CTA -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 bg-white shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] p-3 flex gap-2 z-50">
        <button class="flex-1 bg-teal-800 hover:bg-teal-900 text-white font-bold py-3 px-2 rounded-lg text-sm text-center">
            📞 Dial *XXX#
        </button>
        <button class="flex-1 bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-2 rounded-lg text-sm text-center">
            📱 Get App
        </button>
    </div>

</body>
</html>
