<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Utilitywise — Never Be Caught Off Guard by Your Utility Bill Again</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --teal: #0a6e5c;
    --teal-mid: #0d8c73;
    --teal-light: #12b090;
    --teal-pale: #e6f5f2;
    --amber: #f5a623;
    --amber-dark: #d4891a;
    --cream: #faf8f4;
    --warm-white: #fffef9;
    --charcoal: #1a1f1e;
    --mid-grey: #4a5552;
    --light-grey: #8fa09c;
    --border: #d4e5e1;
    --shadow: rgba(10,110,92,0.12);
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  /* ─── NOISE TEXTURE OVERLAY ─── */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none; z-index: 9999; opacity: 0.4;
  }

  h1, h2, h3, h4 { font-family: 'Syne', sans-serif; }

  /* ─── ANIMATIONS ─── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; } to { opacity: 1; }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  @keyframes progressFill {
    from { width: 0%; } to { width: 73%; }
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.8; }
  }
  @keyframes slideIn {
    from { transform: translateX(-20px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes ripple {
    0% { transform: scale(0); opacity: 0.6; }
    100% { transform: scale(4); opacity: 0; }
  }
  @keyframes countUp { from { opacity: 0; } to { opacity: 1; } }
  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── NAVBAR ─── */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 0 5%;
    height: 70px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(250,248,244,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    animation: fadeIn 0.6s ease;
  }

  .nav-logo {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none;
  }
  .nav-logo-mark {
    width: 38px; height: 38px;
    background: var(--teal);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .nav-logo-mark::after {
    content: '';
    position: absolute;
    width: 18px; height: 18px;
    border: 3px solid var(--amber);
    border-radius: 50%;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
  }
  .nav-logo-text {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--teal);
    letter-spacing: -0.02em;
  }
  .nav-logo-text span { color: var(--amber); }

  .nav-links {
    display: flex; align-items: center; gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--mid-grey);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--teal); }

  .nav-ctas {
    display: flex; align-items: center; gap: 10px;
  }

  .btn-primary {
    background: var(--teal);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border: none; cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    position: relative; overflow: hidden;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-primary:hover { background: var(--teal-mid); transform: translateY(-1px); }
  .btn-primary::after {
    content: '';
    position: absolute;
    width: 30px; height: 30px;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.5s;
  }
  .btn-primary:active::after { transform: translate(-50%, -50%) scale(4); opacity: 0; }

  .btn-ussd {
    background: transparent;
    color: var(--teal);
    padding: 10px 20px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid var(--teal);
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-ussd:hover { background: var(--teal); color: white; }

  /* ─── HERO ─── */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 100px 5% 60px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .orb-1 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(18,176,144,0.18), transparent 70%);
    top: -100px; right: -100px;
    animation: orbFloat 12s ease-in-out infinite;
  }
  .orb-2 {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(245,166,35,0.12), transparent 70%);
    bottom: 0px; left: -80px;
    animation: orbFloat 15s ease-in-out infinite reverse;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    position: relative; z-index: 1;
  }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--teal-pale);
    border: 1px solid rgba(18,176,144,0.3);
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--teal);
    margin-bottom: 24px;
    animation: fadeUp 0.6s ease both;
  }
  .hero-badge-dot {
    width: 6px; height: 6px;
    background: var(--teal-light);
    border-radius: 50%;
    animation: pulse 2s ease infinite;
  }

  .hero-headline {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--charcoal);
    margin-bottom: 20px;
    animation: fadeUp 0.7s 0.1s ease both;
  }
  .hero-headline .accent {
    color: var(--teal);
    position: relative;
    display: inline-block;
  }
  .hero-headline .accent::after {
    content: '';
    position: absolute;
    bottom: 2px; left: 0; right: 0;
    height: 3px;
    background: var(--amber);
    border-radius: 2px;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--mid-grey);
    line-height: 1.7;
    margin-bottom: 36px;
    font-weight: 300;
    max-width: 480px;
    animation: fadeUp 0.7s 0.2s ease both;
  }

  .hero-ctas {
    display: flex; align-items: center; gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
    animation: fadeUp 0.7s 0.3s ease both;
  }

  .btn-hero-primary {
    background: var(--teal);
    color: white;
    padding: 15px 28px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border: none; cursor: pointer;
    transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 8px;
    box-shadow: 0 8px 24px var(--shadow);
  }
  .btn-hero-primary:hover { background: var(--teal-mid); transform: translateY(-2px); box-shadow: 0 12px 32px var(--shadow); }

  .btn-hero-ussd {
    background: white;
    color: var(--teal);
    padding: 15px 28px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid var(--border);
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-hero-ussd:hover { border-color: var(--teal); box-shadow: 0 4px 16px var(--shadow); transform: translateY(-1px); }

  .hero-trust {
    display: flex; align-items: center; gap: 20px;
    font-size: 0.82rem;
    color: var(--light-grey);
    animation: fadeUp 0.7s 0.4s ease both;
  }
  .trust-item { display: flex; align-items: center; gap: 6px; }
  .trust-dot { width: 5px; height: 5px; background: var(--border); border-radius: 50%; }

  /* ─── PHONE MOCKUP ─── */
  .hero-visual {
    display: flex; justify-content: center; align-items: center;
    animation: fadeUp 0.8s 0.2s ease both;
  }

  .phone-wrap {
    position: relative;
    animation: float 6s ease-in-out infinite;
  }

  .phone {
    width: 260px;
    background: var(--charcoal);
    border-radius: 36px;
    padding: 14px;
    box-shadow:
      0 40px 80px rgba(0,0,0,0.25),
      0 0 0 1px rgba(255,255,255,0.08),
      inset 0 0 0 1px rgba(255,255,255,0.05);
    position: relative;
  }

  .phone-notch {
    width: 80px; height: 8px;
    background: #333;
    border-radius: 10px;
    margin: 0 auto 12px;
  }

  .phone-screen {
    background: var(--warm-white);
    border-radius: 24px;
    padding: 18px 14px;
    min-height: 460px;
    overflow: hidden;
  }

  .app-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 18px;
  }
  .app-logo-sm {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--teal);
  }
  .app-avatar {
    width: 28px; height: 28px;
    background: var(--teal-pale);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem;
    color: var(--teal);
    font-weight: 600;
  }

  .app-greeting {
    font-size: 0.72rem;
    color: var(--light-grey);
    margin-bottom: 2px;
  }
  .app-name {
    font-family: 'Syne', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 14px;
  }

  .wallet-card {
    background: linear-gradient(135deg, var(--teal) 0%, var(--teal-mid) 100%);
    border-radius: 16px;
    padding: 16px;
    color: white;
    margin-bottom: 14px;
    position: relative;
    overflow: hidden;
  }
  .wallet-card::before {
    content: '';
    position: absolute;
    width: 120px; height: 120px;
    background: rgba(255,255,255,0.06);
    border-radius: 50%;
    top: -30px; right: -30px;
  }
  .wallet-label { font-size: 0.65rem; opacity: 0.8; margin-bottom: 4px; }
  .wallet-amount {
    font-family: 'Syne', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .wallet-progress-label {
    display: flex; justify-content: space-between;
    font-size: 0.62rem; opacity: 0.8; margin-bottom: 5px;
  }
  .wallet-progress-bar {
    height: 5px;
    background: rgba(255,255,255,0.25);
    border-radius: 3px;
    overflow: hidden;
  }
  .wallet-progress-fill {
    height: 100%;
    background: var(--amber);
    border-radius: 3px;
    width: 0%;
    animation: progressFill 2s 1s ease-out forwards;
  }

  .bills-section { margin-bottom: 14px; }
  .bills-title {
    font-family: 'Syne', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .bill-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px;
    background: white;
    border-radius: 10px;
    margin-bottom: 6px;
    border: 1px solid var(--border);
    animation: slideIn 0.5s ease both;
  }
  .bill-item:nth-child(2) { animation-delay: 0.15s; }
  .bill-item-left { display: flex; align-items: center; gap: 8px; }
  .bill-icon {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem;
  }
  .bill-icon.electric { background: #fff8e8; }
  .bill-icon.water { background: #e8f4ff; }
  .bill-name {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--charcoal);
  }
  .bill-due { font-size: 0.6rem; color: var(--light-grey); }
  .bill-status {
    font-size: 0.6rem;
    padding: 3px 8px;
    border-radius: 20px;
    font-weight: 500;
  }
  .bill-status.saving { background: #e6f5f2; color: var(--teal); }
  .bill-status.paid { background: #e8f8ec; color: #2d8e44; }

  .save-btn {
    width: 100%;
    background: var(--teal);
    color: white;
    border: none;
    padding: 11px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    animation: fadeUp 0.6s 0.5s ease both;
  }

  /* ─── FLOATING BADGES ─── */
  .badge-float {
    position: absolute;
    background: white;
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--charcoal);
    white-space: nowrap;
    border: 1px solid var(--border);
  }
  .badge-saved {
    bottom: 30px; left: -80px;
    animation: float 5s 1s ease-in-out infinite;
  }
  .badge-saved .badge-amount {
    font-family: 'Syne', sans-serif;
    font-size: 1rem;
    font-weight: 800;
    color: var(--teal);
    display: block;
  }
  .badge-reminder {
    top: 80px; right: -90px;
    animation: float 5s 2s ease-in-out infinite;
    display: flex; align-items: center; gap: 6px;
  }
  .badge-reminder-icon {
    width: 24px; height: 24px;
    background: var(--amber);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
  }

  /* ─── LOGOS TICKER ─── */
  .logos-section {
    padding: 28px 5%;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: white;
  }
  .logos-inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; gap: 40px;
    flex-wrap: wrap;
  }
  .logos-label {
    font-size: 0.78rem;
    color: var(--light-grey);
    font-weight: 400;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .logos-row {
    display: flex; align-items: center; gap: 32px; flex-wrap: wrap;
  }
  .partner-logo {
    height: 28px;
    display: flex; align-items: center;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .partner-logo:hover { opacity: 0.8; }
  .partner-logo.mpesa { color: #00a550; font-size: 0.9rem; }
  .partner-logo.kplc { color: #003087; }
  .partner-logo.airtel { color: #e40000; }
  .partner-logo.nairobi { color: #1a1f1e; font-size: 0.82rem; letter-spacing: 0.02em; }
  .partner-logo.safaricom { color: #4CAF50; }

  /* ─── PROBLEM SECTION ─── */
  .problem-section {
    padding: 100px 5%;
    background: var(--charcoal);
    color: white;
    position: relative;
    overflow: hidden;
  }
  .problem-section::before {
    content: '';
    position: absolute;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(18,176,144,0.15), transparent 70%);
    top: -100px; right: -100px;
  }

  .section-tag {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 16px;
  }
  .section-tag.dark { color: var(--teal-light); }
  .section-tag.light { color: var(--teal); }

  .section-headline {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--light-grey);
    max-width: 520px;
    margin-bottom: 56px;
    font-weight: 300;
  }
  .section-sub.white { color: rgba(255,255,255,0.55); }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .problem-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 28px;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }
  .problem-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(18,176,144,0.08), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .problem-card:hover { border-color: rgba(18,176,144,0.3); transform: translateY(-4px); }
  .problem-card:hover::before { opacity: 1; }

  .problem-emoji {
    font-size: 2rem;
    margin-bottom: 16px;
    display: block;
  }
  .problem-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 10px;
  }
  .problem-card p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    font-weight: 300;
  }

  .problem-bridge {
    margin-top: 56px;
    padding: 32px;
    background: linear-gradient(135deg, var(--teal), var(--teal-mid));
    border-radius: 20px;
    display: flex; align-items: center; gap: 24px;
    position: relative; z-index: 1;
  }
  .bridge-icon {
    width: 56px; height: 56px;
    background: rgba(255,255,255,0.15);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .bridge-text h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 4px;
  }
  .bridge-text p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.75);
    font-weight: 300;
  }

  /* ─── HOW IT WORKS ─── */
  .how-section {
    padding: 100px 5%;
    background: var(--cream);
    position: relative;
  }

  .how-inner { max-width: 1200px; margin: 0 auto; }
  .how-header { max-width: 560px; margin-bottom: 70px; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    position: relative;
  }
  .steps-grid::before {
    content: '';
    position: absolute;
    top: 48px; left: 80px; right: 80px;
    height: 1px;
    background: linear-gradient(90deg, var(--teal-light), var(--border), var(--teal-light));
  }

  .step-card {
    padding: 0 32px;
    text-align: center;
    position: relative;
  }

  .step-number-wrap {
    display: flex; justify-content: center;
    margin-bottom: 28px;
  }
  .step-number {
    width: 56px; height: 56px;
    border-radius: 16px;
    background: var(--teal);
    color: white;
    font-family: 'Syne', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 1;
    box-shadow: 0 8px 20px var(--shadow);
  }
  .step-number.amber { background: var(--amber); box-shadow: 0 8px 20px rgba(245,166,35,0.3); }

  .step-icon-large {
    width: 80px; height: 80px;
